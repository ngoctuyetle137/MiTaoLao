<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chúc Ngủ Ngon 💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: radial-gradient(ellipse at bottom, #2b102f 0%, #0c0714 60%, #050208 100%);
      height: 100vh;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Quicksand', sans-serif;
      position: relative;
    }

    /* Vầng trăng êm dịu */
    .moon {
      position: absolute;
      top: 10%;
      right: 15%;
      width: 75px;
      height: 75px;
      background: #fff8eb;
      border-radius: 50%;
      box-shadow: 0 0 45px 15px rgba(255, 220, 240, 0.35);
      z-index: 1;
    }

    /* Sao đêm lấp lánh */
    .star {
      position: absolute;
      background: white;
      border-radius: 50%;
      animation: twinkle var(--duration) infinite ease-in-out;
      opacity: 0.8;
      z-index: 0;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.2; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.3); }
    }

    /* Hiệu ứng trái tim rơi */
    .falling-heart {
      position: absolute;
      top: -50px;
      user-select: none;
      pointer-events: none;
      z-index: 2;
      animation: heartFall linear forwards;
      filter: drop-shadow(0 0 6px rgba(244, 114, 182, 0.6));
    }

    @keyframes heartFall {
      0% {
        top: -10%;
        transform: translateX(0) rotate(0deg) scale(0.8);
        opacity: 0.95;
      }
      50% {
        transform: translateX(var(--drift)) rotate(180deg) scale(1.1);
      }
      100% {
        top: 105%;
        transform: translateX(calc(var(--drift) * -1)) rotate(360deg) scale(0.9);
        opacity: 0.15;
      }
    }

    /* Hộp chữ trung tâm */
    .message-box {
      z-index: 10;
      text-align: center;
      color: #fff;
      opacity: 0;
      transform: scale(0.85);
      animation: fadeInScale 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 1.2s;
      padding: 32px 42px;
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(12px);
      border-radius: 28px;
      border: 1px solid rgba(255, 192, 203, 0.25);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    }

    .message-title {
      font-family: 'Dancing Script', cursive;
      font-size: 4rem;
      background: linear-gradient(135deg, #ff9ebb 0%, #f43f5e 50%, #f472b6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 25px rgba(244, 63, 94, 0.45);
      margin-bottom: 12px;
      animation: softGlow 3s ease-in-out infinite alternate;
    }

    .message-sub {
      font-size: 1.15rem;
      color: #fce7f3;
      letter-spacing: 0.5px;
      line-height: 1.8;
      font-weight: 500;
    }

    .pulse-heart {
      display: inline-block;
      animation: pulse 1.2s infinite;
      color: #fb7185;
    }

    @keyframes fadeInScale {
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes softGlow {
      from { filter: drop-shadow(0 0 8px rgba(244, 63, 94, 0.4)); }
      to { filter: drop-shadow(0 0 22px rgba(244, 114, 182, 0.8)); }
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.3); }
    }

    @media (max-width: 600px) {
      .message-title { font-size: 3rem; }
      .message-sub { font-size: 0.95rem; }
      .message-box { padding: 25px 20px; margin: 0 16px; }
      .moon { width: 50px; height: 50px; }
    }
  </style>
</head>
<body>

  <!-- Trăng sáng -->
  <div class="moon"></div>

  <!-- Khung chữ chúc ngủ ngon -->
  <div class="message-box">
    <div class="message-title">Chúc Gấu Sâu Âu Nầu Ngủ Ngon 💖</div>
    <p class="message-sub">
      Hôm nay bạn đã cố gắng rất nhiều rồi.<br>
      Gác lại mọi lo toan, ngủ một giấc thật sâu và mơ giấc mơ thật ngọt ngào nhé!
    <span class="pulse-heart">❤️</span>  và hãy nhớ rằng:<br>Dù bầu trời này có nắng hay mưa thì anh cũng đau rồi

Dù lần này có thắng hay thua thì anh cũng đành thôi
    </p>
  </div>

  <script>
    // 1. Tạo bầu trời sao đêm lấp lánh
    const body = document.body;
    for (let i = 0; i < 75; i++) {
      const star = document.createElement('div');
      star.className = 'star';
      const size = Math.random() * 3 + 1;
      star.style.width = `${size}px`;
      star.style.height = `${size}px`;
      star.style.left = `${Math.random() * 100}vw`;
      star.style.top = `${Math.random() * 100}vh`;
      star.style.setProperty('--duration', `${Math.random() * 3 + 2}s`);
      body.appendChild(star);
    }

    // 2. Bộ sưu tập các kiểu trái tim & ánh sáng lung linh
    const heartIcons = ['💖', '💕', '💗', '💓', '❤️', '💝', '✨', '🌸'];

    function createHeart() {
      const heart = document.createElement('div');
      heart.className = 'falling-heart';
      heart.innerText = heartIcons[Math.floor(Math.random() * heartIcons.length)];
      
      // Vị trí xuất phát ngẫu nhiên trên bề ngang
      heart.style.left = `${Math.random() * 100}vw`;
      
      // Kích thước ngẫu nhiên
      const size = Math.random() * 22 + 16;
      heart.style.fontSize = `${size}px`;
      
      // Thời gian rơi và khoảng lắc lư hai bên
      const duration = Math.random() * 4 + 5.5;
      const drift = (Math.random() - 0.5) * 140;
      heart.style.animationDuration = `${duration}s`;
      heart.style.setProperty('--drift', `${drift}px`);

      body.appendChild(heart);

      // Dọn dẹp DOM khi rơi hết màn hình
      setTimeout(() => {
        heart.remove();
      }, duration * 1000);
    }

    // Tạo trái tim rơi đều đặn mỗi 280ms
    setInterval(createHeart, 280);

    // Xuất hiện ngay loạt tim ban đầu
    for (let i = 0; i < 12; i++) {
      setTimeout(createHeart, i * 140);
    }
  </script>
</body>
</html>
